+   static vec_t GetRotationRingViewDirection()
+   {
+      matrix_t viewInverse;
+      viewInverse.Inverse(gContext.mViewMat);
+      const float handSign = Dot(Cross(viewInverse.v.right, viewInverse.v.up), viewInverse.v.dir) >= 0.f ? 1.f : -1.f;
+      vec_t direction = gContext.mIsOrthographic ? -viewInverse.v.dir : Normalized(gContext.mCameraDir) * handSign;
+      direction.TransformVector(gContext.mModelInverse);
+      return direction;
+   }
+
+   static void ProjectRotationRing(int axis, const vec_t& viewDirection, int segmentCount, ImVec2* points)
+   {
+      const int ringAxis = 2 - axis;
+      const bool rightHanded = gContext.mProjectionMat.m[2][3] < 0.f;
+      const float angleStart = atan2f(viewDirection[(4 - ringAxis) % 3], viewDirection[(3 - ringAxis) % 3]) + (gContext.mIsOrthographic ? ZPI : -ZPI) * 0.5f + (rightHanded ? 0.f : ZPI);
+      const float radius = gContext.mScreenFactor * rotationDisplayFactor;
+      for (int index = 0; index <= segmentCount; ++index)
+      {
+         const float angle = angleStart + ZPI * ((float)index / (float)halfCircleSegmentCount);
+         const vec_t circlePoint = makeVect(cosf(angle), sinf(angle), 0.f);
+         const vec_t position = makeVect(circlePoint[ringAxis], circlePoint[(ringAxis + 1) % 3], circlePoint[(ringAxis + 2) % 3]) * radius;
+         points[index] = worldToPos(position, gContext.mMVP);
+      }
+   }
